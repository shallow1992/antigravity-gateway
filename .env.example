# ==============================================================================
# Antigravity Gateway 環境変数設定ファイル
# ==============================================================================

# 1. Slack 認証情報 (Socket Mode)
# Slack App 管理画面 (https://api.slack.com/apps) から取得
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# 2. Google Pro OAuth 2.0 連携設定 (Web ダッシュボード用)
# Google Cloud Console (https://console.cloud.google.com/apis/credentials) で発行
# リダイレクトURI: http://localhost:8080/auth/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# 3. セッションスコープ & チャンネル自動参加
# 'thread' (スレッドごとにセッション分離・推奨) または 'channel' (チャンネル直下で1本のタイムラインで対話)
SESSION_MODE=thread
# パブリックチャンネルへの一括自動参加 (true: 自動入室 / false: 手動招待)
AUTO_JOIN_CHANNELS=true

# 4. セキュリティ & アクセス制御
# 許可する Slack ユーザー ID (カンマ区切り、空または "*" で全員許可)
ALLOWED_USER_IDS=*
# 許可する Slack チャンネル ID (カンマ区切り、空で全チャンネル許可)
ALLOWED_CHANNEL_IDS=

# 5. Antigravity ワークスペース設定
# 操作対象のプロジェクトディレクトリの絶対パス (デフォルト: カレントディレクトリ)
TARGET_WORKSPACE_PATH=/Users/HirotakaAsako/Workspace/dev_angr

# 6. Antigravity 権限設定 (Capabilities)
# Remote Control (ファイル編集・コマンド実行) を行う場合は true に設定
ALLOW_FILE_READ=true
ALLOW_FILE_WRITE=true
ALLOW_RUN_COMMAND=true

# 7. ログ設定
LOG_LEVEL=INFO
